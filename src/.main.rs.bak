#[cfg(windows)]
mod app {
    use std::ffi::{c_void, OsStr, OsString};
    use std::iter;
    use std::mem::{size_of, zeroed};
    use std::os::windows::ffi::OsStrExt;
    use std::ptr::{null, null_mut};

    type Handle = *mut c_void;
    type Hwnd = *mut c_void;
    type Hinstance = *mut c_void;
    type Hkey = *mut c_void;

    // SHELLEXECUTEINFO.fMask
    const SEE_MASK_NOCLOSEPROCESS: u32 = 0x0000_0040;
    const SEE_MASK_NOASYNC: u32 = 0x0000_0100;

    // ShowWindow 参数
    const SW_HIDE: i32 = 0;
    const SW_SHOWNORMAL: i32 = 1;
    const SW_SHOWMINIMIZED: i32 = 2;
    const SW_SHOWMAXIMIZED: i32 = 3;

    // WaitForSingleObject
    const INFINITE: u32 = 0xffff_ffff;
    const WAIT_FAILED: u32 = 0xffff_ffff;

    // CoInitializeEx
    const COINIT_APARTMENTTHREADED: u32 = 0x2;
    const COINIT_DISABLE_OLE1DDE: u32 = 0x4;

    // HRESULT: 0x80010106
    const RPC_E_CHANGED_MODE: i32 = 0x8001_0106u32 as i32;

    #[repr(C)]
    union ShellExecuteInfoUnion {
        h_icon: Handle,
        h_monitor: Handle,
    }

    #[repr(C)]
    struct ShellExecuteInfoW {
        cb_size: u32,
        f_mask: u32,
        hwnd: Hwnd,
        lp_verb: *const u16,
        lp_file: *const u16,
        lp_parameters: *const u16,
        lp_directory: *const u16,
        n_show: i32,
        h_inst_app: Hinstance,
        lp_id_list: *mut c_void,
        lp_class: *const u16,
        hkey_class: Hkey,
        dw_hot_key: u32,
        anonymous: ShellExecuteInfoUnion,
        h_process: Handle,
    }

    #[link(name = "shell32")]
    unsafe extern "system" {
        #[link_name = "ShellExecuteExW"]
        fn shell_execute_ex_w(exec_info: *mut ShellExecuteInfoW) -> i32;
    }

    #[link(name = "kernel32")]
    unsafe extern "system" {
        #[link_name = "WaitForSingleObject"]
        fn wait_for_single_object(handle: Handle, milliseconds: u32) -> u32;

        #[link_name = "CloseHandle"]
        fn close_handle(handle: Handle) -> i32;
    }

    #[link(name = "ole32")]
    unsafe extern "system" {
        #[link_name = "CoInitializeEx"]
        fn co_initialize_ex(reserved: *const c_void, coinit: u32) -> i32;

        #[link_name = "CoUninitialize"]
        fn co_uninitialize();
    }

    const USAGE: &str = r#"用法:
  startx.exe [-v <Verb>] [-w] [-d <WorkingDirectory>] [-s <WindowStyle>] <程序路径> [参数...]

选项:
  -v <Verb>              指定 Shell Verb，例如 open、runas、edit、print
  -w                     等待启动的进程退出
  -d <WorkingDirectory>  指定工作目录
  -s <WindowStyle>       Normal、Hidden、Minimized 或 Maximized
  -h, --help             显示帮助

说明:
  选项必须位于程序路径之前。
  程序路径之后的全部参数都会传递给目标程序。
  使用 -- 可以显式结束 startx 的选项解析。

示例:
  startx.exe notepad.exe
  startx.exe notepad.exe "C:\Documents\hello world.txt"
  startx.exe -w notepad.exe "C:\Documents\test.txt"
  startx.exe -v runas cmd.exe /k whoami
  startx.exe -v runas -w cmd.exe /c "whoami && pause"
  startx.exe -d "C:\Work" app.exe --config "dev config.json"
  startx.exe -s Minimized app.exe
  startx.exe -s Hidden cmd.exe /c "echo hello > C:\Temp\result.txt"
  startx.exe -- "-special-name.exe" -v child-argument
"#;

    struct Config {
        verb: Option<OsString>,
        wait: bool,
        working_directory: Option<OsString>,
        window_style: i32,
        file_path: OsString,
        arguments: Vec<OsString>,
    }

    enum ParseResult {
        Run(Config),
        Help,
    }

    /// COM 初始化守卫。
    ///
    /// 如果本线程已经使用另一种 Apartment 模式初始化，
    /// RPC_E_CHANGED_MODE 不视为致命错误，但也不能调用 CoUninitialize。
    struct ComGuard {
        should_uninitialize: bool,
    }

    impl ComGuard {
        fn initialize() -> Result<Self, String> {
            let result = unsafe {
                co_initialize_ex(
                    null(),
                    COINIT_APARTMENTTHREADED | COINIT_DISABLE_OLE1DDE,
                )
            };

            if result >= 0 {
                return Ok(Self {
                    should_uninitialize: true,
                });
            }

            if result == RPC_E_CHANGED_MODE {
                return Ok(Self {
                    should_uninitialize: false,
                });
            }

            Err(format!(
                "CoInitializeEx 失败：HRESULT=0x{:08X}",
                result as u32
            ))
        }
    }

    impl Drop for ComGuard {
        fn drop(&mut self) {
            if self.should_uninitialize {
                unsafe {
                    co_uninitialize();
                }
            }
        }
    }

    struct OwnedHandle(Handle);

    impl Drop for OwnedHandle {
        fn drop(&mut self) {
            if !self.0.is_null() {
                unsafe {
                    close_handle(self.0);
                }
            }
        }
    }

    fn parse_window_style(value: &OsStr) -> Result<i32, String> {
        let value = value.to_string_lossy();

        if value.eq_ignore_ascii_case("normal") {
            Ok(SW_SHOWNORMAL)
        } else if value.eq_ignore_ascii_case("hidden") {
            Ok(SW_HIDE)
        } else if value.eq_ignore_ascii_case("minimized") {
            Ok(SW_SHOWMINIMIZED)
        } else if value.eq_ignore_ascii_case("maximized") {
            Ok(SW_SHOWMAXIMIZED)
        } else {
            Err(format!(
                "无效的 WindowStyle：{value}；可选值为 Normal、Hidden、Minimized、Maximized"
            ))
        }
    }

    fn parse_arguments() -> Result<ParseResult, String> {
        let args: Vec<OsString> = std::env::args_os().skip(1).collect();

        if args.is_empty() {
            return Ok(ParseResult::Help);
        }

        let mut verb = None;
        let mut wait = false;
        let mut working_directory = None;
        let mut window_style = SW_SHOWNORMAL;

        let mut index = 0;

        while index < args.len() {
            let token = args[index].to_string_lossy();

            match token.as_ref() {
                "-h" | "--help" => {
                    return Ok(ParseResult::Help);
                }

                "--" => {
                    index += 1;
                    break;
                }

                "-w" => {
                    wait = true;
                    index += 1;
                }

                "-v" => {
                    if index + 1 >= args.len() {
                        return Err("-v 后缺少 Verb 参数".to_string());
                    }

                    verb = Some(args[index + 1].clone());
                    index += 2;
                }

                "-d" => {
                    if index + 1 >= args.len() {
                        return Err("-d 后缺少 WorkingDirectory 参数".to_string());
                    }

                    working_directory = Some(args[index + 1].clone());
                    index += 2;
                }

                "-s" => {
                    if index + 1 >= args.len() {
                        return Err("-s 后缺少 WindowStyle 参数".to_string());
                    }

                    window_style = parse_window_style(&args[index + 1])?;
                    index += 2;
                }

                _ if token.starts_with('-') => {
                    return Err(format!(
                        "未知选项：{token}\n\
                         如果程序路径本身以“-”开头，请在它前面加 --"
                    ));
                }

                _ => {
                    // 第一个非选项参数就是目标路径。
                    break;
                }
            }
        }

        if index >= args.len() {
            return Err("缺少程序路径".to_string());
        }

        let file_path = args[index].clone();
        let arguments = args[index + 1..].to_vec();

        Ok(ParseResult::Run(Config {
            verb,
            wait,
            working_directory,
            window_style,
            file_path,
            arguments,
        }))
    }

    /// 转换为以 NUL 结尾的 UTF-16 字符串。
    fn wide_z(value: &OsStr) -> Vec<u16> {
        value.encode_wide().chain(iter::once(0)).collect()
    }

    /// 按 Windows CommandLineToArgvW / C Runtime 常用规则引用一个参数。
    ///
    /// ShellExecuteExW 的 lpParameters 是一整条字符串，
    /// 因此必须将 Rust 收到的独立参数重新组合。
    fn append_quoted_argument(output: &mut Vec<u16>, argument: &OsStr) {
        const SPACE: u16 = b' ' as u16;
        const TAB: u16 = b'\t' as u16;
        const QUOTE: u16 = b'"' as u16;
        const BACKSLASH: u16 = b'\\' as u16;

        let chars: Vec<u16> = argument.encode_wide().collect();

        let needs_quotes = chars.is_empty()
            || chars
                .iter()
                .any(|character| matches!(*character, SPACE | TAB | QUOTE));

        if !needs_quotes {
            output.extend_from_slice(&chars);
            return;
        }

        output.push(QUOTE);

        let mut backslash_count = 0usize;

        for character in chars {
            if character == BACKSLASH {
                backslash_count += 1;
                continue;
            }

            if character == QUOTE {
                // 引号前面的反斜杠必须加倍，并额外转义引号。
                output.extend(iter::repeat(BACKSLASH).take(backslash_count * 2 + 1));
                output.push(QUOTE);
            } else {
                output.extend(iter::repeat(BACKSLASH).take(backslash_count));
                output.push(character);
            }

            backslash_count = 0;
        }

        // 结束引号前的反斜杠必须加倍。
        output.extend(iter::repeat(BACKSLASH).take(backslash_count * 2));
        output.push(QUOTE);
    }

    /// 生成 ShellExecuteExW.lpParameters。
    fn build_parameter_string(arguments: &[OsString]) -> Vec<u16> {
        let mut output = Vec::new();

        for (index, argument) in arguments.iter().enumerate() {
            if index != 0 {
                output.push(b' ' as u16);
            }

            append_quoted_argument(&mut output, argument.as_os_str());
        }

        output.push(0);
        output
    }

    fn optional_wide_pointer(value: &Option<Vec<u16>>) -> *const u16 {
        value
            .as_ref()
            .map_or(null(), |value| value.as_ptr())
    }

    fn execute(config: Config) -> Result<(), String> {
        let _com_guard = ComGuard::initialize()?;

        let file_path = wide_z(config.file_path.as_os_str());

        let verb = config
            .verb
            .as_ref()
            .map(|value| wide_z(value.as_os_str()));

        let working_directory = config
            .working_directory
            .as_ref()
            .map(|value| wide_z(value.as_os_str()));

        let parameters = if config.arguments.is_empty() {
            None
        } else {
            Some(build_parameter_string(&config.arguments))
        };

        let mut mask = SEE_MASK_NOASYNC;

        if config.wait {
            mask |= SEE_MASK_NOCLOSEPROCESS;
        }

        let mut execute_info: ShellExecuteInfoW = unsafe { zeroed() };

        execute_info.cb_size = size_of::<ShellExecuteInfoW>() as u32;
        execute_info.f_mask = mask;
        execute_info.hwnd = null_mut();
        execute_info.lp_verb = optional_wide_pointer(&verb);
        execute_info.lp_file = file_path.as_ptr();
        execute_info.lp_parameters = optional_wide_pointer(&parameters);
        execute_info.lp_directory = optional_wide_pointer(&working_directory);
        execute_info.n_show = config.window_style;

        let success = unsafe {
            shell_execute_ex_w(&mut execute_info)
        };

        if success == 0 {
            let os_error = std::io::Error::last_os_error();
            let shell_error = execute_info.h_inst_app as usize;

            return Err(format!(
                "ShellExecuteExW 启动失败：{os_error}；Shell 错误代码：{shell_error}"
            ));
        }

        if config.wait {
            if execute_info.h_process.is_null() {
                return Err(
                    "目标已启动，但 Windows Shell 没有返回进程句柄，因此无法执行 -w 等待。\n\
                     这通常发生在 Shell 复用已有进程、DDE 启动或某些 URL/文件关联启动中。"
                        .to_string(),
                );
            }

            let process_handle = OwnedHandle(execute_info.h_process);

            let wait_result = unsafe {
                wait_for_single_object(process_handle.0, INFINITE)
            };

            if wait_result == WAIT_FAILED {
                return Err(format!(
                    "等待目标进程失败：{}",
                    std::io::Error::last_os_error()
                ));
            }
        }

        Ok(())
    }

    pub fn run() -> i32 {
        match parse_arguments() {
            Ok(ParseResult::Help) => {
                println!("{USAGE}");
                0
            }

            Ok(ParseResult::Run(config)) => match execute(config) {
                Ok(()) => 0,
                Err(error) => {
                    eprintln!("startx: {error}");
                    1
                }
            },

            Err(error) => {
                eprintln!("startx: {error}\n");
                eprintln!("{USAGE}");
                2
            }
        }
    }
}

#[cfg(windows)]
fn main() {
    std::process::exit(app::run());
}

#[cfg(not(windows))]
fn main() {
    eprintln!("startx 只支持 Windows。");
    std::process::exit(1);
}